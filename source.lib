--[[
    Frozen UI Library
    Clean • Modern • Full Component Support
    Version 2.1
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local Mouse = LocalPlayer:GetMouse()

-- Cleanup
if PlayerGui:FindFirstChild("FrozenUI") then
	PlayerGui.FrozenUI:Destroy()
end

local Frozen = {
	Version = "2.0.0",
	Windows = {},
	Flags = {},
	Theme = {
		Background = Color3.fromRGB(8, 12, 24),
		Card = Color3.fromRGB(14, 20, 40),
		Accent = Color3.fromRGB(40, 90, 200),
		Text = Color3.fromRGB(235, 245, 255),
		SubText = Color3.fromRGB(150, 175, 220),
		Stroke = Color3.fromRGB(50, 90, 180)
	}
}

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FrozenUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.IgnoreGuiInset = true
ScreenGui.Parent = PlayerGui

------------------------------------------------------------------
-- OPEN INTERFACE BUTTON (moved left, clean style)
------------------------------------------------------------------
local OpenBtn = Instance.new("TextButton")
OpenBtn.Name = "OpenInterface"
OpenBtn.Size = UDim2.fromOffset(150, 36)
OpenBtn.Position = UDim2.new(0, 18, 0, 14) -- more to the left side
OpenBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
OpenBtn.Text = "Open Interface"
OpenBtn.Font = Enum.Font.GothamBold
OpenBtn.TextSize = 14
OpenBtn.TextColor3 = Color3.fromRGB(235, 245, 255)
OpenBtn.AutoButtonColor = false
OpenBtn.ZIndex = 50
OpenBtn.Parent = ScreenGui

local OpenCorner = Instance.new("UICorner")
OpenCorner.CornerRadius = UDim.new(0, 9)
OpenCorner.Parent = OpenBtn

local OpenGrad = Instance.new("UIGradient")
OpenGrad.Color = ColorSequence.new{
	ColorSequenceKeypoint.new(0.00, Color3.fromRGB(15, 25, 55)),
	ColorSequenceKeypoint.new(1.00, Color3.fromRGB(35, 80, 180))
}
OpenGrad.Rotation = 115
OpenGrad.Parent = OpenBtn

local OpenStroke = Instance.new("UIStroke")
OpenStroke.Color = Color3.fromRGB(70, 130, 230)
OpenStroke.Thickness = 1.3
OpenStroke.Transparency = 0.2
OpenStroke.Parent = OpenBtn

------------------------------------------------------------------
-- UTILITY
------------------------------------------------------------------
local function Create(class, props)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		inst[k] = v
	end
	return inst
end

local function AddCorner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 8)
	c.Parent = parent
	return c
end

local function AddStroke(parent, color, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color or Frozen.Theme.Stroke
	s.Thickness = thickness or 1
	s.Transparency = 0.35
	s.Parent = parent
	return s
end

local function Tween(obj, props, time)
	TweenService:Create(obj, TweenInfo.new(time or 0.2, Enum.EasingStyle.Quad), props):Play()
end

------------------------------------------------------------------
-- WINDOW
------------------------------------------------------------------
function Frozen:CreateWindow(config)
	config = config or {}
	local name = config.Name or "Frozen"
	local size = config.Size or UDim2.new(0, 520, 0, 420)

	local Window = {
		Tabs = {},
		SelectedTab = nil
	}

	local Main = Create("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size,
		BackgroundColor3 = Frozen.Theme.Background,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 10,
		Parent = ScreenGui
	})
	AddCorner(Main, 12)
	AddStroke(Main)

	local Grad = Create("UIGradient", {
		Color = ColorSequence.new{
			ColorSequenceKeypoint.new(0.00, Color3.fromRGB(8, 12, 24)),
			ColorSequenceKeypoint.new(1.00, Color3.fromRGB(20, 40, 90))
		},
		Rotation = 140,
		Parent = Main
	})

	-- Title bar
	local TitleBar = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 42),
		BackgroundTransparency = 1,
		Parent = Main
	})

	local Title = Create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 10),
		Size = UDim2.new(0.7, 0, 0, 22),
		Font = Enum.Font.GothamBold,
		Text = name,
		TextColor3 = Frozen.Theme.Text,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = TitleBar
	})

	local Close = Create("TextButton", {
		Size = UDim2.fromOffset(30, 30),
		Position = UDim2.new(1, -40, 0, 6),
		BackgroundColor3 = Color3.fromRGB(25, 30, 50),
		Text = "×",
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		TextColor3 = Frozen.Theme.Text,
		AutoButtonColor = false,
		Parent = TitleBar
	})
	AddCorner(Close, 7)

	Close.MouseButton1Click:Connect(function()
		Main.Visible = false
		OpenBtn.Text = "Open Interface"
	end)

	-- Tab bar
	local TabBar = Create("Frame", {
		Size = UDim2.new(1, -24, 0, 32),
		Position = UDim2.new(0, 12, 0, 48),
		BackgroundTransparency = 1,
		Parent = Main
	})

	local TabList = Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		Parent = TabBar
	})

	-- Content area
	local Content = Create("ScrollingFrame", {
		Size = UDim2.new(1, -24, 1, -92),
		Position = UDim2.new(0, 12, 0, 88),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Frozen.Theme.Accent,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Main
	})

	local ContentList = Create("UIListLayout", {
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = Content
	})

	------------------------------------------------------------------
	-- CREATE TAB
	------------------------------------------------------------------
	function Window:CreateTab(tabName)
		local Tab = {
			Name = tabName,
			Elements = {}
		}

		local TabBtn = Create("TextButton", {
			Size = UDim2.fromOffset(90, 28),
			BackgroundColor3 = Color3.fromRGB(20, 28, 55),
			Text = tabName,
			Font = Enum.Font.GothamBold,
			TextSize = 13,
			TextColor3 = Frozen.Theme.Text,
			AutoButtonColor = false,
			Parent = TabBar
		})
		AddCorner(TabBtn, 7)

		local Page = Create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			BackgroundTransparency = 1,
			Visible = false,
			AutomaticSize = Enum.AutomaticSize.Y,
			Parent = Content
		})

		local PageList = Create("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = Page
		})

		function Tab:Show()
			for _, t in pairs(Window.Tabs) do
				t.Page.Visible = false
			end
			Page.Visible = true
			Window.SelectedTab = Tab

			for _, b in ipairs(TabBar:GetChildren()) do
				if b:IsA("TextButton") then
					b.BackgroundColor3 = Color3.fromRGB(20, 28, 55)
				end
			end
			TabBtn.BackgroundColor3 = Frozen.Theme.Accent
		end

		TabBtn.MouseButton1Click:Connect(function()
			Tab:Show()
		end)

		------------------------------------------------------------------
		-- SECTION
		------------------------------------------------------------------
		function Tab:CreateSection(text)
			local sec = Create("TextLabel", {
				Size = UDim2.new(1, 0, 0, 22),
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold,
				Text = text,
				TextColor3 = Frozen.Theme.Text,
				TextSize = 14,
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = #Page:GetChildren(),
				Parent = Page
			})
			return sec
		end

		------------------------------------------------------------------
		-- BUTTON
		------------------------------------------------------------------
		function Tab:CreateButton(opts)
			opts = opts or {}
			local btn = Create("TextButton", {
				Size = UDim2.new(1, 0, 0, 36),
				BackgroundColor3 = Color3.fromRGB(22, 32, 65),
				Text = opts.Name or "Button",
				Font = Enum.Font.GothamBold,
				TextSize = 14,
				TextColor3 = Frozen.Theme.Text,
				AutoButtonColor = false,
				LayoutOrder = #Page:GetChildren(),
				Parent = Page
			})
			AddCorner(btn, 8)
			AddStroke(btn)

			btn.MouseButton1Click:Connect(function()
				if opts.Callback then
					opts.Callback()
				end
			end)
			return btn
		end

		------------------------------------------------------------------
		-- TOGGLE
		------------------------------------------------------------------
		function Tab:CreateToggle(opts)
			opts = opts or {}
			local flag = opts.Flag or opts.Name
			local state = opts.Default or false
			Frozen.Flags[flag] = state

			local frame = Create("Frame", {
				Size = UDim2.new(1, 0, 0, 38),
				BackgroundColor3 = Color3.fromRGB(18, 26, 52),
				LayoutOrder = #Page:GetChildren(),
				Parent = Page
			})
			AddCorner(frame, 8)

			local label = Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 14, 0, 0),
				Size = UDim2.new(0.7, 0, 1, 0),
				Font = Enum.Font.GothamBold,
				Text = opts.Name or "Toggle",
				TextColor3 = Frozen.Theme.Text,
				TextSize = 14,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = frame
			})

			local toggle = Create("Frame", {
				Size = UDim2.fromOffset(42, 22),
				Position = UDim2.new(1, -54, 0.5, -11),
				BackgroundColor3 = state and Frozen.Theme.Accent or Color3.fromRGB(40, 45, 70),
				Parent = frame
			})
			AddCorner(toggle, 11)

			local circle = Create("Frame", {
				Size = UDim2.fromOffset(16, 16),
				Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
				BackgroundColor3 = Color3.fromRGB(255, 255, 255),
				Parent = toggle
			})
			AddCorner(circle, 8)

			local function set(val)
				state = val
				Frozen.Flags[flag] = val
				Tween(toggle, {BackgroundColor3 = val and Frozen.Theme.Accent or Color3.fromRGB(40, 45, 70)})
				Tween(circle, {Position = val and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)})
				if opts.Callback then opts.Callback(val) end
			end

			frame.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					set(not state)
				end
			end)

			return {Set = set, Get = function() return state end}
		end

		------------------------------------------------------------------
		-- NUMBER INPUT
		------------------------------------------------------------------
		function Tab:CreateNumber(opts)
			opts = opts or {}
			local flag = opts.Flag or opts.Name
			local value = opts.Default or 0
			local min = opts.Min or 0
			local max = opts.Max or 100
			Frozen.Flags[flag] = value

			local frame = Create("Frame", {
				Size = UDim2.new(1, 0, 0, 42),
				BackgroundColor3 = Color3.fromRGB(18, 26, 52),
				LayoutOrder = #Page:GetChildren(),
				Parent = Page
			})
			AddCorner(frame, 8)

			local label = Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 14, 0, 4),
				Size = UDim2.new(0.6, 0, 0, 16),
				Font = Enum.Font.GothamBold,
				Text = opts.Name or "Number",
				TextColor3 = Frozen.Theme.Text,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = frame
			})

			local box = Create("TextBox", {
				Size = UDim2.fromOffset(70, 24),
				Position = UDim2.new(1, -84, 0.5, -12),
				BackgroundColor3 = Color3.fromRGB(25, 35, 70),
				Text = tostring(value),
				Font = Enum.Font.GothamBold,
				TextSize = 13,
				TextColor3 = Frozen.Theme.Text,
				Parent = frame
			})
			AddCorner(box, 6)

			box.FocusLost:Connect(function()
				local num = tonumber(box.Text)
				if num then
					num = math.clamp(num, min, max)
					value = num
					Frozen.Flags[flag] = num
					box.Text = tostring(num)
					if opts.Callback then opts.Callback(num) end
				else
					box.Text = tostring(value)
				end
			end)

			return {
				Set = function(v)
					value = math.clamp(v, min, max)
					Frozen.Flags[flag] = value
					box.Text = tostring(value)
				end
			}
		end

		------------------------------------------------------------------
		-- KEYBIND
		------------------------------------------------------------------
		function Tab:CreateKeybind(opts)
			opts = opts or {}
			local flag = opts.Flag or opts.Name
			local key = opts.Default or Enum.KeyCode.Unknown
			Frozen.Flags[flag] = key

			local frame = Create("Frame", {
				Size = UDim2.new(1, 0, 0, 38),
				BackgroundColor3 = Color3.fromRGB(18, 26, 52),
				LayoutOrder = #Page:GetChildren(),
				Parent = Page
			})
			AddCorner(frame, 8)

			local label = Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 14, 0, 0),
				Size = UDim2.new(0.55, 0, 1, 0),
				Font = Enum.Font.GothamBold,
				Text = opts.Name or "Keybind",
				TextColor3 = Frozen.Theme.Text,
				TextSize = 14,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = frame
			})

			local keyBtn = Create("TextButton", {
				Size = UDim2.fromOffset(90, 24),
				Position = UDim2.new(1, -104, 0.5, -12),
				BackgroundColor3 = Color3.fromRGB(25, 35, 70),
				Text = key.Name,
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				TextColor3 = Frozen.Theme.Text,
				AutoButtonColor = false,
				Parent = frame
			})
			AddCorner(keyBtn, 6)

			local listening = false
			keyBtn.MouseButton1Click:Connect(function()
				listening = true
				keyBtn.Text = "..."
			end)

			UserInputService.InputBegan:Connect(function(input, gp)
				if listening and input.UserInputType == Enum.UserInputType.Keyboard then
					listening = false
					key = input.KeyCode
					Frozen.Flags[flag] = key
					keyBtn.Text = key.Name
					if opts.Callback then opts.Callback(key) end
				elseif not gp and input.KeyCode == key and opts.Callback then
					opts.Callback(key)
				end
			end)

			return {Get = function() return key end}
		end

		------------------------------------------------------------------
		-- SELECTABLE (Dropdown)
		------------------------------------------------------------------
		function Tab:CreateDropdown(opts)
			opts = opts or {}
			local flag = opts.Flag or opts.Name
			local options = opts.Options or {"Option 1", "Option 2"}
			local current = opts.Default or options[1]
			Frozen.Flags[flag] = current

			local frame = Create("Frame", {
				Size = UDim2.new(1, 0, 0, 38),
				BackgroundColor3 = Color3.fromRGB(18, 26, 52),
				LayoutOrder = #Page:GetChildren(),
				Parent = Page
			})
			AddCorner(frame, 8)

			local label = Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 14, 0, 0),
				Size = UDim2.new(0.5, 0, 1, 0),
				Font = Enum.Font.GothamBold,
				Text = opts.Name or "Select",
				TextColor3 = Frozen.Theme.Text,
				TextSize = 14,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = frame
			})

			local dropBtn = Create("TextButton", {
				Size = UDim2.fromOffset(120, 24),
				Position = UDim2.new(1, -134, 0.5, -12),
				BackgroundColor3 = Color3.fromRGB(25, 35, 70),
				Text = current,
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				TextColor3 = Frozen.Theme.Text,
				AutoButtonColor = false,
				Parent = frame
			})
			AddCorner(dropBtn, 6)

			local open = false
			local listFrame = nil

			dropBtn.MouseButton1Click:Connect(function()
				if open then
					if listFrame then listFrame:Destroy() end
					open = false
					return
				end
				open = true
				listFrame = Create("Frame", {
					Size = UDim2.new(0, 120, 0, #options * 26),
					Position = UDim2.new(1, -134, 1, 4),
					BackgroundColor3 = Color3.fromRGB(20, 28, 55),
					ZIndex = 20,
					Parent = frame
				})
				AddCorner(listFrame, 6)

				for i, opt in ipairs(options) do
					local item = Create("TextButton", {
						Size = UDim2.new(1, 0, 0, 26),
						Position = UDim2.new(0, 0, 0, (i-1)*26),
						BackgroundTransparency = 1,
						Text = opt,
						Font = Enum.Font.GothamBold,
						TextSize = 12,
						TextColor3 = Frozen.Theme.Text,
						ZIndex = 21,
						Parent = listFrame
					})
					item.MouseButton1Click:Connect(function()
						current = opt
						Frozen.Flags[flag] = opt
						dropBtn.Text = opt
						listFrame:Destroy()
						open = false
						if opts.Callback then opts.Callback(opt) end
					end)
				end
			end)

			return {Set = function(v) current = v; dropBtn.Text = v; Frozen.Flags[flag] = v end}
		end

		------------------------------------------------------------------
		-- SIDELOADER (simple script loader)
		------------------------------------------------------------------
		function Tab:CreateSideloader(opts)
			opts = opts or {}
			local frame = Create("Frame", {
				Size = UDim2.new(1, 0, 0, 90),
				BackgroundColor3 = Color3.fromRGB(18, 26, 52),
				LayoutOrder = #Page:GetChildren(),
				Parent = Page
			})
			AddCorner(frame, 8)

			local label = Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 14, 0, 8),
				Size = UDim2.new(1, -28, 0, 16),
				Font = Enum.Font.GothamBold,
				Text = opts.Name or "Sideloader",
				TextColor3 = Frozen.Theme.Text,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = frame
			})

			local box = Create("TextBox", {
				Size = UDim2.new(1, -28, 0, 28),
				Position = UDim2.new(0, 14, 0, 28),
				BackgroundColor3 = Color3.fromRGB(25, 35, 70),
				PlaceholderText = "Paste script URL or code...",
				Text = "",
				Font = Enum.Font.Gotham,
				TextSize = 12,
				TextColor3 = Frozen.Theme.Text,
				ClearTextOnFocus = false,
				Parent = frame
			})
			AddCorner(box, 6)

			local loadBtn = Create("TextButton", {
				Size = UDim2.new(1, -28, 0, 24),
				Position = UDim2.new(0, 14, 0, 62),
				BackgroundColor3 = Frozen.Theme.Accent,
				Text = "Load",
				Font = Enum.Font.GothamBold,
				TextSize = 13,
				TextColor3 = Color3.fromRGB(255, 255, 255),
				AutoButtonColor = false,
				Parent = frame
			})
			AddCorner(loadBtn, 6)

			loadBtn.MouseButton1Click:Connect(function()
				local src = box.Text
				if src == "" then return end
				local success, err = pcall(function()
					if src:find("http") then
						loadstring(game:HttpGet(src))()
					else
						loadstring(src)()
					end
				end)
				if opts.Callback then
					opts.Callback(success, err)
				end
			end)
		end

		Tab.Page = Page
		table.insert(Window.Tabs, Tab)

		if #Window.Tabs == 1 then
			Tab:Show()
		end

		return Tab
	end

	function Window:Toggle()
		Main.Visible = not Main.Visible
		OpenBtn.Text = Main.Visible and "Close Interface" or "Open Interface"
	end

	function Window:Open()
		Main.Visible = true
		OpenBtn.Text = "Close Interface"
	end

	function Window:Close()
		Main.Visible = false
		OpenBtn.Text = "Open Interface"
	end

	table.insert(Frozen.Windows, Window)

	-- Connect open button to first window
	if #Frozen.Windows == 1 then
		OpenBtn.MouseButton1Click:Connect(function()
			Window:Toggle()
		end)
	end

	return Window
end

-- Global keybind example support
UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.RightShift then
		if Frozen.Windows[1] then
			Frozen.Windows[1]:Toggle()
		end
	end
end)

if getgenv then
	getgenv().Frozen = Frozen
end

print("[Frozen] Library v2.0 loaded")
return Frozen
